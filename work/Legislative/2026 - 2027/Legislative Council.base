views:
  - type: cards
    name: Table
    filters:
      and:
        - file.tags.contains("contact")
        - file.tags.contains("Legislative")
        - note["A.Y"].contains("2026 - 2027")
    order:
      - file.name
      - role.abbr
      - A.Y
      - tags
      - org.abbr
    image: note.image
